---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/sections/Footer.astro";
import Thanks from "../components/sections/Thanks.astro";
import thanks from "../content/thanks.json";
---

<Layout title={thanks.pageTitle} noindex>
  <main>
    <Thanks title={thanks.title} text={thanks.text} button={thanks.button} />
  </main>
  <Footer flush />
</Layout>
