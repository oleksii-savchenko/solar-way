---
import hero from "../content/hero.json";
import { image } from "../utils/image";
import { tel } from "../utils/tel";

// На білому фоні точка логотипа жовта завжди, на жовтому — лише коли меню відкрите
const { light = false } = Astro.props;
---

<header class="header" data-site-header>
  <button
    class="menu-toggle"
    type="button"
    aria-label={hero.menu.openLabel}
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-toggle
    data-open-label={hero.menu.openLabel}
    data-close-label={hero.menu.closeLabel}
  >
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
  </button>
  <a class="logo" href={hero.logo.href}>
    {hero.logo.before}
    <img class="when-closed" {...image(light ? hero.logo.dotMenuOpen : hero.logo.dot)} alt="" />
    <img class="when-open" {...image(hero.logo.dotMenuOpen)} alt="" />
    {hero.logo.after}
  </a>
  <a class="phone" href={tel(hero.phone.text)}>{hero.phone.text}</a>
</header>

<nav class="menu" id="site-menu" data-menu-panel>
  {hero.menu.links.map((link) => <a href={link.href}>{link.text}</a>)}
  <a class="menu-phone" href={tel(hero.phone.text)}>{hero.phone.text}</a>
</nav>

<style>
  .header {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header img {
    display: block;
  }

  .header a,
  .menu a {
    color: inherit;
    text-decoration: none;
  }

  .header:not(.is-open) .when-open,
  .header.is-open .when-closed {
    display: none;
  }

  /* Іконка з макета: 38×14, лінія 2px, хрестик під кутом 20.9° */
  .menu-toggle {
    --unit: calc(var(--text-field) / 9);
    order: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: calc(var(--unit) * 19);
    height: calc(var(--unit) * 7);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .bar {
    height: var(--unit);
    background: var(--color-text);
    transition:
      transform 0.4s,
      opacity 0.2s;
  }

  .is-open .bar:nth-child(1) {
    transform: translateY(calc(var(--unit) * 3)) rotate(20.9deg);
  }

  .is-open .bar:nth-child(2) {
    opacity: 0;
  }

  .is-open .bar:nth-child(3) {
    transform: translateY(calc(var(--unit) * -3)) rotate(-20.9deg);
  }

  /* Панель відкривається від верху найближчого батька з position, щонайменше на його висоту */
  .menu {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
    padding-top: calc(var(--space-gutter) * 6);
    padding-bottom: calc(var(--space-gutter) * 2);
    background: var(--color-white);
    font-size: calc(var(--text-footer-link) * 0.875);
    font-weight: var(--font-weight-regular);
    line-height: calc(var(--leading-link) * 4 / 3);
    visibility: hidden;
    transform: translateY(-100%);
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.5s;
  }

  .menu.is-open {
    visibility: visible;
    transform: none;
  }

  .menu a {
    position: relative;
    transition: color 0.3s;
  }

  /* Лінія виїжджає зліва направо і так само повертається назад */
  .menu a::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: calc(var(--text-field) / 18);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s;
  }

  .menu a:focus-visible {
    color: var(--color-accent);
  }

  .menu a:focus-visible::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .menu a:hover {
      color: var(--color-accent);
    }

    .menu a:hover::after {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu a,
    .menu a::after,
    .bar {
      transition: none;
    }
  }

  .menu-phone {
    margin-top: calc(var(--space-gutter) * 2.5);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: calc(var(--space-grid-gap) * 1.5);
    font-size: calc(var(--text-small-1) * 1.24);
    line-height: var(--leading-number);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  /* Пропорції точки відносно шрифту логотипа, з макета */
  .logo img {
    width: 0.733em;
  }

  .phone {
    display: none;
  }

  @media (min-width: 768px) {
    .header {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .menu-toggle {
      order: 0;
      justify-self: start;
    }

    .menu {
      flex-direction: row;
      justify-content: space-between;
      padding: 0 var(--space-gutter);
      font-size: var(--text-form-title);
      line-height: var(--leading-normal);
      letter-spacing: var(--tracking-normal);
    }

    .menu-phone {
      display: none;
    }

    .logo {
      gap: var(--space-grid-gap);
      font-size: var(--text-number-caption);
    }

    .phone {
      display: block;
      justify-self: end;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]")!;
  const toggle = header.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]")!;

  function setOpen(open: boolean) {
    header.classList.toggle("is-open", open);
    panel.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", (open ? toggle.dataset.closeLabel : toggle.dataset.openLabel)!);
  }

  toggle.addEventListener("click", () => setOpen(!panel.classList.contains("is-open")));
  panel.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (!header.contains(target) && !panel.contains(target)) setOpen(false);
  });
</script>
