---
import SiteHeader from "../SiteHeader.astro";
import contacts from "../../content/contacts.json";
import hero from "../../content/hero.json";
import privacy from "../../content/privacy.json";
---

<section class="privacy">
  <div class="top" data-reveal>
    <SiteHeader light />
    <h1 class="title">{privacy.title}</h1>
  </div>

  <div class="body" data-reveal>
    <p class="updated">{privacy.updated}</p>
    <p>{privacy.intro}</p>

    {
      privacy.sections.map((section) => (
        <>
          <h2 class="heading">{section.title}</h2>
          <p>{section.text}</p>
        </>
      ))
    }

    <h2 class="heading">{privacy.contactsTitle}</h2>
    <p>
      {hero.logo.before}
      {hero.logo.after}<br />
      {contacts.address}<br />
      <a href={hero.phone.href}>{hero.phone.text}</a><br />
      <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
    </p>
  </div>
</section>

<style>
  .privacy {
    position: relative;
    container-type: inline-size;
  }

  .top {
    padding: calc(var(--space-gutter) * 1.5) var(--space-gutter) 0;
  }

  .title {
    margin: calc(var(--space-gutter) * 2.5) 0 0;
    font-family: var(--font-display);
    font-size: calc(var(--text-number) * 0.33);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-number);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  .body {
    padding: var(--space-gutter) var(--space-gutter) calc(var(--space-gutter) * 2.5);
    font-size: calc(var(--text-small-2) * 1.05);
    line-height: var(--leading-link);
  }

  .body p {
    margin: 0 0 var(--space-gutter);
  }

  .body a {
    color: inherit;
  }

  .heading {
    margin: calc(var(--space-gutter) * 1.5) 0 calc(var(--space-gutter) / 2);
    font-size: var(--text-small-1);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-normal);
  }

  @media (min-width: 768px) {
    .top {
      position: relative;
      padding: calc(var(--space-gutter) - var(--space-grid-gap) * 3) var(--space-gutter) var(--space-grid-edge);
    }

    .title {
      margin-top: var(--space-gutter);
      font-size: calc(var(--text-number) * 0.35);
    }

    .body {
      padding: calc(var(--space-gutter) / 2 - var(--space-grid-gap)) var(--space-gutter) var(--space-section);
      font-size: var(--text-small-2);
    }

    .body p {
      margin-bottom: calc(var(--space-gutter) / 4);
    }

    .heading {
      margin: calc(var(--space-gutter) / 2) 0 calc(var(--space-gutter) / 10);
    }
  }
</style>
