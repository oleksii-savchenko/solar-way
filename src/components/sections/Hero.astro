---
import Button from "../Button.astro";
import SiteHeader from "../SiteHeader.astro";
import hero from "../../content/hero.json";
---

<section class="hero">
  <div class="top">
    <div data-hero-step="header">
      <SiteHeader />
    </div>

    <h1 class="title">
      {
        hero.title.split(/(\s+)/).map((part) =>
          part.trim() ? (
            <span class="word" data-hero-step="title">
              {part}
            </span>
          ) : (
            part
          ),
        )
      }
    </h1>
  </div>

  <div class="content">
    <p class="lead" data-hero-step="lead">{hero.lead}</p>

    <div class="center">
      <div class="tagline" data-hero-step="tagline">
        <img src={hero.brackets} alt="" />
        <p>{hero.tagline}</p>
      </div>
      <Button text={hero.button} data-open-popup="popup-form" data-hero-step="button" />
    </div>

    <ul class="features">
      {
        hero.features.map((feature) => (
          <li class="feature" data-hero-step="features">
            <img src={feature.icon} alt="" />
            <p>{feature.text}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <img class="panel" data-hero-step="panel" src={hero.panel.src} alt={hero.panel.alt} />
</section>

<style>
  .hero {
    position: relative;
    container-type: inline-size;
    background: var(--color-accent);
  }

  .hero img {
    display: block;
    max-width: 100%;
  }

  .hero p {
    margin: 0;
  }

  .hero a {
    color: inherit;
    text-decoration: none;
  }

  .top {
    padding: calc(var(--space-gutter) * 1.5) var(--space-gutter) 0;
  }

  .title {
    margin: calc(var(--space-gutter) * 2.5) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-tight);
    text-align: center;
    text-transform: uppercase;
    white-space: pre-line;
    text-box: trim-both cap alphabetic;
  }

  .word {
    display: inline-block;
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: calc(var(--space-gutter) * 1.4);
    padding-inline: var(--space-gutter);
  }

  .center {
    display: contents;
  }

  .lead {
    order: 1;
    text-align: center;
  }

  .lead,
  .feature p {
    white-space: pre-line;
  }

  .tagline {
    order: 2;
    display: grid;
    place-items: center;
    margin-top: var(--space-gutter);
    font-family: var(--font-display);
    font-size: var(--text-description);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
  }

  .tagline > * {
    grid-area: 1 / 1;
  }

  /* Пропорції дужок відносно шрифту, з макета */
  .tagline img {
    width: 4.854em;
  }

  .features {
    order: 3;
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin: calc(var(--space-gutter) * 1.8) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-small-2);
  }

  .feature {
    display: flex;
    align-items: center;
    gap: calc(var(--space-grid-gap) * 3);
  }

  .feature:nth-child(2) {
    gap: calc(var(--space-grid-gap) * 7);
  }

  /* Пропорції іконок відносно шрифту, з макета */
  .feature:nth-child(1) img {
    width: 3.5em;
  }

  .feature:nth-child(2) img {
    width: 1.65em;
  }

  .content :global(.button) {
    order: 4;
    margin-top: calc(var(--space-gutter) * 1.5);
  }

  .panel {
    margin: calc(var(--space-gutter) * 1.5) auto 0;
    width: calc(100% - var(--space-gutter));
  }

  @media (min-width: 768px) {
    .top {
      position: relative;
      padding: calc(var(--space-gutter) - var(--space-grid-gap) * 3) var(--space-gutter) var(--space-grid-edge);
    }

    .content {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .title {
      margin-top: calc(var(--space-gutter) + var(--space-grid-gap) * 2);
      white-space: nowrap;
    }

    .content {
      position: relative;
      z-index: 1;
      align-items: normal;
      /* Знизу місце під фото: висота за його пропорціями мінус заїзд під кнопку */
      margin: calc(var(--space-gutter) / 2 - var(--space-grid-gap) / 2) var(--space-gutter)
        calc((100cqw - var(--space-gutter) * 3 - var(--space-grid-gap) * 4) * 578 / 3192 - var(--space-gutter) * 0.39);
      padding-inline: 0;
    }

    .lead,
    .features {
      order: 0;
    }

    .lead {
      padding-top: calc(var(--space-grid-gap) * 3);
      text-align: left;
    }

    .center {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: calc(var(--space-gutter) / 2 - var(--space-grid-gap));
    }

    .tagline {
      margin-top: 0;
    }

    .content :global(.button) {
      margin-top: 0;
    }

    .features {
      display: grid;
      grid-template-columns: auto auto;
      justify-self: end;
      align-content: start;
      width: auto;
      margin: 0;
      column-gap: calc(var(--space-grid-gap) * 2);
      row-gap: calc(var(--space-gutter) / 2 + var(--space-grid-gap) * 2);
      padding-top: var(--space-grid-edge);
      padding-right: var(--space-grid-edge);
    }

    .feature,
    .feature:nth-child(2) {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
      align-items: normal;
      justify-items: center;
      gap: normal;
    }

    .feature p {
      justify-self: start;
      translate: 0 var(--space-grid-gap);
    }

    .panel {
      position: absolute;
      bottom: 0;
      left: calc(var(--space-gutter) * 1.5 + var(--space-grid-gap) * 2);
      width: calc(100% - var(--space-gutter) * 3 - var(--space-grid-gap) * 4);
      margin: 0;
    }
  }
</style>

