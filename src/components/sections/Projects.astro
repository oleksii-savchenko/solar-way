---
import Button from "../Button.astro";
import projects from "../../content/projects.json";
import { image } from "../../utils/image";
---

<section class="projects" id="projects">
  <div class="head" data-reveal>
    <h2 class="title" data-blur-title>
      <span>{projects.title.first}</span>
      {projects.title.second}
    </h2>
    <div class="head-right">
      <div class="about">
        <img src={projects.brackets.left} alt="" />
        <p>{projects.about}</p>
        <img src={projects.brackets.right} alt="" />
      </div>
      <div class="stat">
        <p class="stat-value" data-counter>{projects.stat.value}<span>{projects.stat.suffix}</span></p>
        <p class="stat-caption">{projects.stat.caption}</p>
      </div>
    </div>
  </div>

  <div class="grid" data-projects-grid data-reveal-group>
    {
      projects.items.map((item) => (
        <button
          class="card"
          type="button"
          data-lightbox-open
          data-image={image(item.image).src}
          data-alt={item.imageAlt}
          data-city={item.city}
          data-text={item.text}
        >
          <img
            class="card-image"
            {...image(item.image, "(min-width: 768px) 46vw, 100vw")}
            alt={item.imageAlt}
            loading="lazy"
          />
          <span class="card-top">
            <span class="city">
              <img src={projects.dot} alt="" />
              {item.city}
            </span>
            <span class="card-text">{item.text}</span>
          </span>
        </button>
      ))
    }
  </div>

  <div class="more" data-projects-more data-reveal>
    <Button text={projects.viewMore} />
  </div>
</section>

<dialog class="lightbox" data-lightbox>
  <form method="dialog">
    <button class="lightbox-close" aria-label={projects.closeLabel}>
      <img src={projects.closeIcon} alt="" />
    </button>
  </form>
  <figure class="lightbox-figure">
    <img class="lightbox-image" data-lightbox-image alt="" />
    <figcaption class="lightbox-caption">
      <span class="city" data-lightbox-city></span>
      <span class="card-text" data-lightbox-text></span>
    </figcaption>
  </figure>
</dialog>

<style>
  .projects {
    margin-top: calc(var(--space-gutter) * 3.15);
    padding-top: calc(var(--space-gutter) * 2.5);
    background: var(--color-text);
    color: var(--color-white);
  }

  .projects p {
    margin: 0;
  }

  .title,
  .stat-value,
  .stat-caption,
  .city {
    font-family: var(--font-display);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-number);
    text-transform: uppercase;
  }

  .head {
    padding-inline: var(--space-gutter);
  }

  .title {
    margin: 0;
    font-size: calc(var(--text-number) * 0.66);
    letter-spacing: var(--tracking-tight);
  }

  .title span {
    display: block;
    color: var(--color-accent);
  }

  /* На мобільному цифра стоїть вище за опис */
  .head-right {
    display: flex;
    flex-direction: column-reverse;
    gap: calc(var(--space-gutter) * 1.85);
    margin-top: calc(var(--space-gutter) * 0.75);
  }

  .about {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-grid-gap);
    font-size: calc(var(--text-small-2) * 1.14);
  }

  .about p {
    white-space: pre-line;
  }

  /* Пропорції дужок відносно шрифту, з макета */
  .about img {
    flex: none;
    width: 0.509em;
  }

  .stat-value {
    font-size: calc(var(--text-number) * 0.53);
  }

  .stat-value span {
    color: var(--color-accent);
  }

  .stat-caption {
    font-size: calc(var(--text-number-caption) * 1.06);
  }

  .city {
    font-size: calc(var(--text-number-caption) * 1.11);
  }

  .grid {
    display: grid;
    gap: var(--space-grid-gap);
    margin-top: calc(var(--space-gutter) * 1.4);
  }

  .card {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-white);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  /* На мобільному спочатку три проєкти, решту відкриває кнопка */
  .grid:not(.is-expanded) .card:nth-child(n + 4) {
    display: none;
  }

  .more {
    padding: calc(var(--space-gutter) * 1.15) var(--space-gutter) var(--space-gutter);
  }

  .card-image {
    display: block;
    width: 100%;
    aspect-ratio: 948 / 585;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.3s;
  }

  .card:hover .card-image,
  .card:focus-visible .card-image {
    filter: grayscale(0);
  }

  .card-top {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: calc(var(--space-gutter) * 0.45) var(--space-gutter) calc(var(--space-gutter) * 0.6);
    border-bottom: 1px solid var(--color-white);
  }

  .city {
    display: flex;
    align-items: center;
    gap: calc(var(--space-gutter) * 0.5);
  }

  /* Пропорції точки відносно шрифту, з макета */
  .city img {
    width: 0.567em;
  }

  .card-text {
    font-size: calc(var(--text-small-2) * 0.84);
    text-align: right;
    white-space: pre-line;
  }

  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: calc(var(--space-gutter) / 2);
    border: 0;
    background: none;
    color: var(--color-white);
    opacity: 0;
    transition:
      opacity 0.3s,
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }

  .lightbox[open] {
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 1;
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--color-text) 90%, transparent);
    backdrop-filter: blur(var(--space-grid-gap));
    opacity: 0;
    transition:
      opacity 0.3s,
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }

  .lightbox[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .lightbox[open],
    .lightbox[open]::backdrop {
      opacity: 0;
    }
  }

  .lightbox-close {
    position: fixed;
    top: var(--space-gutter);
    right: var(--space-gutter);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* Ширину блоку задає фото, підпис її не розширює */
  .lightbox-figure {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-gutter) / 4);
    width: fit-content;
    margin: 0;
  }

  .lightbox-image {
    display: block;
    max-width: calc(100vw - var(--space-gutter));
    max-height: calc(100dvh - var(--space-gutter) * 1.75);
  }

  .lightbox-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-gutter);
    width: 0;
    min-width: 100%;
  }

  @media (min-width: 768px) {
    .projects {
      container-type: inline-size;
      margin-top: var(--space-section);
      padding: var(--space-section) var(--space-grid-edge) var(--space-grid-edge);
    }

    .head {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: end;
      margin: 0 calc(var(--space-gutter) - var(--space-grid-edge)) var(--space-gutter);
      padding-inline: 0;
    }

    .title {
      margin-left: calc(var(--space-grid-gap) * -1);
      font-size: var(--text-number);
    }

    .head-right {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0;
      margin-top: 0;
    }

    .about {
      justify-content: flex-start;
      gap: calc(var(--space-gutter) / 2 - var(--space-grid-gap));
      font-size: var(--text-small-1);
    }

    .stat {
      margin-top: calc(var(--space-grid-gap) * -2);
    }

    .stat-value {
      font-size: calc(var(--text-number) / 2);
    }

    .stat-caption,
    .city {
      font-size: var(--text-number-caption);
    }

    .grid {
      grid-template-columns: 1fr 1fr;
      margin-top: 0;
    }

    .grid:not(.is-expanded) .card:nth-child(n + 4) {
      display: block;
    }

    .more {
      display: none;
    }

    .card-top {
      padding: calc(var(--space-gutter) / 2 - var(--space-grid-gap) * 2) calc(var(--space-gutter) - var(--space-grid-edge))
        calc(var(--space-gutter) / 3);
    }

    .city {
      gap: calc(var(--space-grid-gap) * 2);
    }

    .card-text {
      font-size: var(--text-small-2);
    }

    .lightbox-close {
      top: calc(var(--space-gutter) / 2);
      right: calc(var(--space-gutter) / 2);
    }
  }
</style>

<script>
  import { revealCards } from "../../scripts/reveal";

  const lightbox = document.querySelector<HTMLDialogElement>("[data-lightbox]")!;
  const image = lightbox.querySelector<HTMLImageElement>("[data-lightbox-image]")!;
  const city = lightbox.querySelector<HTMLElement>("[data-lightbox-city]")!;
  const text = lightbox.querySelector<HTMLElement>("[data-lightbox-text]")!;

  document.querySelectorAll<HTMLElement>("[data-lightbox-open]").forEach((card) => {
    card.addEventListener("click", () => {
      image.src = card.dataset.image!;
      image.alt = card.dataset.alt!;
      city.textContent = card.dataset.city!;
      text.textContent = card.dataset.text!;
      lightbox.showModal();
    });
  });

  const more = document.querySelector<HTMLElement>("[data-projects-more]")!;
  more.addEventListener("click", () => {
    const grid = document.querySelector("[data-projects-grid]")!;
    const hiddenCards = [...grid.children].filter((card) => !card.getClientRects().length);
    grid.classList.add("is-expanded");
    more.hidden = true;
    revealCards(hiddenCards);
  });
</script>
