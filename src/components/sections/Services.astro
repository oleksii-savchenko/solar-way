---
import Button from "../Button.astro";
import services from "../../content/services.json";
---

<section class="services" id="services">
  <div class="head" data-reveal>
    <h2 class="title" data-blur-title>
      {services.title.first}
      <span>{services.title.second}</span>
    </h2>
    <div class="fact">
      <img class="fact-icon" src={services.fact.icon} alt="" />
      <p class="fact-value" data-counter>{services.fact.value}</p>
      <p class="fact-text">{services.fact.text}</p>
    </div>
  </div>

  {
    services.items.map((item) => (
      <article class="service" data-reveal>
        <div class="info">
          <div class="info-top">
            <h3 class="service-title">{item.title}</h3>
            <p class="number">{item.number}</p>
          </div>
          <p class="text">{item.text}</p>
          <Button
            text={services.button}
            variant="accent"
            data-open-popup="popup-form"
            data-service={item.title.replace("\n", " ")}
          />
        </div>
        <img
          class:list={["image", { "image--mirrored": item.imageMirrored }]}
          src={item.image}
          alt={item.imageAlt}
          loading="lazy"
        />
      </article>
    ))
  }
</section>

<style>
  .services {
    padding-top: calc(var(--space-gutter) * 3.2);
  }

  .services p {
    margin: 0;
  }

  .title,
  .fact-value,
  .service-title,
  .number {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-number);
    text-transform: uppercase;
  }

  .head {
    padding-inline: var(--space-gutter);
  }

  .title {
    font-size: calc(var(--text-number) * 0.66);
    letter-spacing: var(--tracking-tight);
  }

  .title span {
    display: block;
    color: var(--color-accent);
  }

  .fact {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: calc(var(--space-gutter) * 0.6);
    margin-top: calc(var(--space-gutter) * 0.8);
  }

  .fact-icon {
    width: calc(var(--space-gutter) * 1.9);
  }

  .fact-value {
    font-size: calc(var(--text-number) * 0.345);
  }

  .fact-text {
    grid-column: 2;
    font-size: calc(var(--text-small-2) * 1.05);
  }

  .services .fact-text {
    margin-top: calc(var(--space-gutter) * 0.65);
  }

  .service {
    display: flex;
    flex-direction: column;
    margin-top: calc(var(--space-gutter) * 1.55);
  }

  .info {
    padding-inline: calc(var(--space-gutter) * 1.1);
  }

  .service-title {
    font-size: calc(var(--text-number) * 0.33);
    letter-spacing: var(--tracking-tight);
    white-space: pre-line;
  }

  .number {
    display: none;
    color: var(--color-accent);
    font-size: var(--text-number-caption);
  }

  .text {
    font-size: var(--text-small-2);
  }

  .services .text {
    margin: calc(var(--space-gutter) * 1.75) 0 calc(var(--space-gutter) * 1.15);
  }

  .image {
    order: -1;
    display: block;
    width: 100%;
    aspect-ratio: 390 / 182;
    margin-bottom: calc(var(--space-gutter) * 1.3);
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.3s;
  }

  .image:hover {
    filter: grayscale(0);
  }

  .image--mirrored {
    scale: -1 1;
  }

  @media (min-width: 768px) {
    .services {
      container-type: inline-size;
      padding: calc(var(--space-section) - var(--space-gutter) / 3) var(--space-gutter) 0;
    }

    .head {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: calc(var(--space-gutter) + var(--space-grid-edge) * 3);
      padding-inline: 0;
    }

    .title {
      margin-left: calc(var(--space-grid-gap) * -1);
      font-size: var(--text-number);
    }

    .fact {
      display: flex;
      gap: calc(var(--space-gutter) / 4);
      margin-top: 0;
    }

    .fact-icon {
      align-self: center;
      width: auto;
    }

    .fact-value {
      font-size: calc(var(--text-number) / 2);
    }

    .fact-text {
      font-size: calc(var(--text-small-2) * 0.8);
      white-space: pre-line;
    }

    .services .fact-text {
      margin-top: var(--space-grid-gap);
    }

    .service {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-top: 0;
      border-bottom: 1px solid var(--color-text);
    }

    .service + .service {
      margin-top: calc(var(--space-gutter) - var(--space-grid-edge) * 2);
    }

    .info {
      padding-inline: 0;
    }

    .info-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-right: calc(var(--space-gutter) / 2);
    }

    .service-title {
      font-size: calc(var(--text-number) * 0.35);
    }

    .number {
      display: block;
    }

    .services .number {
      margin-top: var(--space-grid-gap);
    }

    .text {
      white-space: pre-line;
    }

    .services .text {
      margin: calc(var(--space-gutter) / 2) 0 calc(var(--space-gutter) / 3);
    }

    .image {
      order: 0;
      height: calc(var(--space-section) * 2);
      aspect-ratio: auto;
      margin-bottom: 0;
    }
  }
</style>
