---
import Button from "./Button.astro";
import popup from "../content/popup-form.json";
---

<dialog class="popup" id="popup-form" aria-labelledby="popup-form-title" autofocus>
  <div class="inner">
    <h2 class="title" id="popup-form-title">{popup.title}</h2>
    <p class="description">{popup.description}</p>
    <form class="form" novalidate data-popup-form>
      <!-- Послуга, з якої прийшов запит. Порожньо, якщо поп-ап відкрито не з блоку послуг -->
      <input type="hidden" name="service" data-popup-service />
      <input
        class="field"
        type="text"
        name="name"
        autocomplete="name"
        aria-label={popup.name.placeholder}
        placeholder={popup.name.placeholder}
        data-placeholder={popup.name.placeholder}
        data-error={popup.name.error}
      />
      <input
        class="field"
        type="tel"
        name="phone"
        autocomplete="tel"
        aria-label={popup.phone.placeholder}
        placeholder={popup.phone.placeholder}
        data-placeholder={popup.phone.placeholder}
        data-error={popup.phone.error}
      />
      <Button text={popup.button} variant="accent" type="submit" />
    </form>
  </div>
</dialog>

<style>
  .popup {
    width: calc(100% - var(--space-gutter));
    max-width: none;
    padding: 0;
    border: 0;
    outline: 0;
    background: var(--color-text);
    color: var(--color-white);
    text-align: center;
    opacity: 0;
    transition:
      opacity 0.3s,
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }

  .popup[open] {
    opacity: 1;
  }

  .popup::backdrop {
    background: color-mix(in srgb, var(--color-text) 90%, transparent);
    backdrop-filter: blur(var(--space-grid-gap));
    opacity: 0;
    transition:
      opacity 0.3s,
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }

  .popup[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .popup[open],
    .popup[open]::backdrop {
      opacity: 0;
    }
  }

  /* Відступи на внутрішньому блоці: клік по самому dialog означає клік по фону */
  .inner {
    padding: calc(var(--space-gutter) * 2) var(--space-gutter);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-form-title);
    font-weight: var(--font-weight-regular);
    line-height: var(--leading-number);
    letter-spacing: var(--tracking-normal);
    text-transform: uppercase;
  }

  .description {
    margin: var(--space-gutter) 0 0;
    font-size: var(--text-small-1);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-grid-gap) * 4);
    margin-top: calc(var(--space-gutter) * 1.5);
  }

  .field {
    width: 100%;
    padding: calc(var(--space-gutter) * 1.3) calc(var(--space-gutter) * 1.2);
    border: 1px solid var(--color-field-border);
    border-radius: 0;
    outline: 0;
    background: var(--color-text);
    color: var(--color-white);
    font: inherit;
    font-size: var(--text-field);
    font-weight: var(--font-weight-regular);
    letter-spacing: inherit;
  }

  .field::placeholder {
    color: var(--color-placeholder);
    opacity: 1;
  }

  .field:focus,
  .field:not(:placeholder-shown) {
    border-color: var(--color-white);
  }

  .field.is-error {
    border-color: var(--color-error);
  }

  .field.is-error::placeholder {
    color: var(--color-error);
  }

  .form :global(.button) {
    --button-hover-bg: var(--color-white);
    --button-hover-color: var(--color-text);
  }

  .form.has-errors :global(.button) {
    --button-hover-bg: var(--color-line);
    background: var(--color-line);
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    /* Ширину вікна задає опис, поля вужчі за нього, як у макеті */
    .popup {
      width: fit-content;
    }

    .inner {
      padding: calc(var(--space-gutter) - var(--space-grid-edge)) calc(var(--space-gutter) * 0.59);
    }

    .description {
      margin-top: calc(var(--space-gutter) / 3);
      font-size: var(--text-small-2);
      white-space: pre-line;
    }

    .form {
      gap: calc(var(--space-grid-gap) * 2);
      margin: calc(var(--space-gutter) / 2 + var(--space-grid-gap)) calc(var(--space-gutter) * 0.38) 0;
    }

    .field {
      padding: calc(var(--space-gutter) * 0.28) calc(var(--space-gutter) / 3);
    }

    .form :global(.button) {
      width: 100%;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-popup-form]")!;
  const popup = form.closest("dialog")!;
  const service = form.querySelector<HTMLInputElement>("[data-popup-service]")!;
  const fields = form.querySelectorAll<HTMLInputElement>(".field");

  const validators: Record<string, (value: string) => boolean> = {
    name: (value) => /^[\p{L}\s'’-]{2,}$/u.test(value.trim()),
    phone: (value) => /^\+?[\d\s()-]+$/.test(value.trim()) && value.replace(/\D/g, "").length >= 10,
  };

  function clearError(field: HTMLInputElement) {
    field.classList.remove("is-error");
    field.placeholder = field.dataset.placeholder!;
    form.classList.toggle("has-errors", form.querySelector(".is-error") !== null);
  }

  // Як у UI-кіті: при помилці повідомлення стоїть у самому полі
  function showError(field: HTMLInputElement) {
    field.value = "";
    field.classList.add("is-error");
    field.placeholder = field.dataset.error!;
    form.classList.add("has-errors");
  }

  fields.forEach((field) => field.addEventListener("focus", () => clearError(field)));

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    fields.forEach((field) => {
      if (!validators[field.name](field.value)) showError(field);
    });
    if (form.querySelector(".is-error")) return;

    // Сюди підключимо відправку заявки в Telegram: new FormData(form)
    window.location.href = "/thanks";
  });

  popup.addEventListener("close", () => {
    form.reset();
    fields.forEach(clearError);
  });

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const opener = target.closest<HTMLElement>("[data-open-popup]");

    if (opener) {
      service.value = opener.dataset.service ?? "";
      (document.getElementById(opener.dataset.openPopup!) as HTMLDialogElement).showModal();
    } else if (target instanceof HTMLDialogElement) {
      // Клік по фону
      target.close();
    }
  });
</script>
